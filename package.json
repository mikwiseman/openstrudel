{
  "name": "openstrudel",
  "version": "0.1.0",
  "description": "One personal AI runtime for Mac, Raspberry Pi, Linux and Windows",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "type": "module",
  "bin": {
    "openstrudel": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@openai/codex": "0.156.1",
    "@xai-official/grok": "1.0.52",
    "cron-parser": "5.10.1",
    "google-auth-library": "11.3.3",
    "marked": "18.0.14",
    "smol-toml": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
