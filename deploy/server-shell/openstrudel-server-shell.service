[Unit]
Description=OpenStrudel server shell: runs the Home owner's commands on this server
After=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/openstrudel-server-shell/runner.py @SPOOL@
Restart=always
RestartSec=2
# Restarting the runner must not stop a command that is running, such as an update of the Home.
KillMode=process
Environment=HOME=/root USER=root LANG=C.UTF-8 PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
