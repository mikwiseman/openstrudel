# OpenStrudel
OPENSTRUDEL_DB=.data/openstrudel.sqlite
OPENSTRUDEL_HOST=127.0.0.1
OPENSTRUDEL_PORT=7788
# Leave unset to use the local Codex login and subscription.
OPENSTRUDEL_CODEX_MODEL=gpt-6-astra
# Set to mock only for offline tests.
OPENSTRUDEL_CODEX_MODE=codex
# OPENSTRUDEL_WEB_SEARCH_MODE=cached
# Optional API protection.
# OPENSTRUDEL_API_TOKEN=change-me
# Telegram long polling. You can also configure it from the native app;
# the validated token is then kept in the Home's private SQLite settings.
# TELEGRAM_BOT_TOKEN=123456:replace-me
