# Install as /srv/wai-vds/runtime.env, owner root, mode 0600.
# Blank credentials intentionally prevent start. Only use the dedicated WAI VDS App.
WAI_HOST=0.0.0.0
WAI_PORT=4781
WAI_ORIGIN=https://server.waiwai.is
WAI_SECURE_COOKIE=1
WAI_DATA=/var/lib/wai-vds
WAI_PROVIDER=kamatera
WAI_PAYMENTS=wai_pay
WAI_PAY_BASE_URL=https://pay.waiwai.is
WAI_PAY_MODE=live
WAI_PAY_API_KEY=
WAI_PAY_WEBHOOK_SECRET=
WAI_PAY_CARD_ENABLED=1
WAI_PAY_CRYPTO_ENABLED=1
WAI_PAY_STRIPE_ACCOUNT_ID=stripe-vds
WAI_PAY_CRYPTO_ACCOUNT_ID=cryptomus-main
# RUB stays disabled until an explicit price and suitable merchant are selected.
WAI_PAY_RUB_AMOUNT=0
WAI_PAY_TBANK_ACCOUNT_ID=
WAI_KAMATERA_CLIENT_ID=
WAI_KAMATERA_SECRET=
WAI_REGION=EU
WAI_APPROVED_IMAGE=EU:7a74bdc0c8034ce9a1fd28d8ed91f8f5
# Closed by default. Production promotion follows paid-flow, backup and health checks.
WAI_ALLOW_PAID_VM=
WAI_MAX_PROVIDER_MONTHLY_USD=0
WAI_MAX_LIVE_SERVERS=1

# Caddy is on the inspected private Docker bridge. Do not trust arbitrary clients.
WAI_TRUSTED_PROXY_CIDRS=172.18.0.0/16

# Magic-link mail. Secret stays on the backend; sender must be verified in Resend.
WAI_MAGIC_LINK_ENABLED=0
WAI_RESEND_API_KEY=
WAI_RESEND_FROM=WAI Server <login@mail.waiwai.is>
