# Local acceptance defaults. No money and no VM are created.
WAI_HOST=127.0.0.1
WAI_PORT=4781
WAI_ORIGIN=http://127.0.0.1:4781
WAI_DATA=work/runtime
WAI_PROVIDER=emulator
WAI_PAYMENTS=emulator
# Live infrastructure is deliberately disabled until a specific budget is agreed.
# WAI_PROVIDER=kamatera
WAI_KAMATERA_CLIENT_ID=
WAI_KAMATERA_SECRET=
WAI_ALLOW_PAID_VM=
WAI_MAX_LIVE_SERVERS=1
WAI_MAX_PROVIDER_MONTHLY_USD=0
# Confirm the account total, including taxes, before enabling paid infrastructure.
WAI_APPROVED_IMAGE=
WAI_REGION=EU
# Optional direct Stripe TEST merchant. Direct sk_live keys are rejected.
# WAI_PAYMENTS=stripe_test
WAI_STRIPE_SECRET_KEY=
WAI_STRIPE_WEBHOOK_SECRET=
# Production hosting requires HTTPS + WAI_SECURE_COOKIE=1. Do not expose emulator.
WAI_SECURE_COOKIE=0

# Real hosted card/crypto payments use your own WAI Pay application (API v2).
# Changing TEST/LIVE requires a separate WAI_DATA directory.
# WAI_PAYMENTS=wai_pay
WAI_PAY_BASE_URL=https://pay.waiwai.is
WAI_PAY_API_KEY=
WAI_PAY_WEBHOOK_SECRET=
WAI_PAY_MODE=live
WAI_PAY_CARD_ENABLED=0
WAI_PAY_STRIPE_ACCOUNT_ID=
WAI_PAY_CRYPTO_ENABLED=0
WAI_PAY_CRYPTO_ACCOUNT_ID=
# TBank is optional: choose the proper merchant and a fixed inclusive RUB price.
# Amount is in kopecks, not a live currency conversion.
WAI_PAY_TBANK_ACCOUNT_ID=
WAI_PAY_RUB_AMOUNT=0
# Production origin: https://server.waiwai.is
# OpenStrudel Home is a separate 4 GB / 30 GB profile. Retail price is NOT $12.
# Default gate stays closed. Tests may set a synthetic amount in emulator only.
WAI_HOME_AMOUNT_MINOR=0
WAI_HOME_IMAGE=EU:6000c29549da189eaef6ea8a31001a34
WAI_HOME_LIVE_APPROVAL=
# Exact public-client callbacks. HTTPS web callbacks must be operator registered.
# WAI_OPENSTRUDEL_REDIRECTS=["openstrudel://oauth/wai-vds"]
# WAI_OPENSTRUDEL_PAYMENT_REDIRECTS=["openstrudel://checkout/wai-vds"]

# Magic-link mail. Secret stays on the backend; sender must be verified in Resend.
WAI_MAGIC_LINK_ENABLED=0
WAI_RESEND_API_KEY=
WAI_RESEND_FROM=WAI Server <login@mail.waiwai.is>
